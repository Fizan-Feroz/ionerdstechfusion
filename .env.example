# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
DATABASE_URL=sqlite:///./backend/data/vitals.db
DATABASE_PATH=backend/data/vitals.db

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Discord Configuration
# Get webhook URL: Discord Server → Settings → Webhooks → Create Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
VITE_DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token

# Discord Bot (for commands like !hello, !testalert, !status)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# MQTT Configuration (optional)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=vitals

# ML Model Configuration
MODEL_PATH=ml/models/lstm_baseline.pt
PHYSIONET_DATA_PATH=C:\Users\<username>\Downloads\physionet-data

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=true
RELOAD=true
